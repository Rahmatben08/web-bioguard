[Unit]
Description=Laravel Queue Worker for BioGuard
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/bioguard/bio_guard_backend
ExecStart=/usr/bin/php artisan queue:work database --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
